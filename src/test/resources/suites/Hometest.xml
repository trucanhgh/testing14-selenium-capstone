<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite">
    <test verbose="2" preserve-order="true"
          name="Home Page Tests">
        <classes>
            <class name="testcase.ui.homePage.HomePageBannerTest">
                <methods>
                    <include name="verifyBannerDisplaysCorrectly"/>
                    <include name="verifyStartButtonNavigation"/>
                </methods>
            </class>
            <class name="testcase.ui.homePage.HomePageIntroductionTest">
                <methods>
                    <include name="verifyCourseSectionDisplayedCorrectly"/>
                    <include name="verifyCourseCardHoverEffect"/>
                    <include name="verifyCourseCardUI"/>
                </methods>
            </class>
            <class name="testcase.ui.homePage.HomePageCourseTest">
                <methods>
                    <include name="verifyCourseTitles"/>
                    <include name="verifyCourseCardInformation"/>
                    <include name="verifyHoverCourseCard"/>
                    <include name="verifyClickCourseCard"/>
                </methods>
            </class>
            <class name="testcase.ui.homePage.HomePageStatisticTest">
                <methods><include name="verifyStatisticIcons"/>
                    <include name="verifyStatisticTitles"/>
                    <include name="verifyStatisticNumbers"/>
                </methods>
            </class>
            <class name="testcase.ui.homePage.HomePageInstructorTest">
                <methods>
                    <include name="verifyInstructorSectionDisplayedCorrectly"/>
                    <include name="verifyInstructorHoverEffect"/>
                    <include name="verifyClickInstructorCard"/>
                </methods>
            </class>
            <class name="testcase.ui.homePage.HomePageTestimonialTest">
                <methods>
                    <include name="verifyStudentReviewDisplayedCorrectly"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>