<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Full Regression Suite">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="All UI Tests" preserve-order="true">
        <classes>
            <class name="testcase.ui.homepage.HomePageBannerTest"/>
            <class name="testcase.ui.homepage.HomePageIntroductionTest"/>
            <class name="testcase.ui.homepage.HomePageCourseTest"/>
            <class name="testcase.ui.homepage.HomePageStatisticTest"/>
            <class name="testcase.ui.homepage.HomePageInstructorTest"/>
            <class name="testcase.ui.homepage.HomePageTestimonialTest"/>

            <class name="testcase.ui.profile.ProfileViewTest"/>
            <class name="testcase.ui.profile.CourseTabTest"/>
            <class name="testcase.ui.profile.EditProfileValidationTest"/>

            <class name="testcase.ui.blog.BlogTest"/>
        </classes>
    </test>
</suite>